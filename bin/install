#!/usr/bin/env bash
# Install shared dependencies; retain both environment names for existing scripts.
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
  '') target_env=table-dtr ;;
  --tools) target_env=scidiscovery ;;
  -h|--help)
    echo 'Usage: bash bin/install [--tools]'
    echo 'Default: table retrieval (table-dtr). --tools: data/figure tools (scidiscovery).'
    exit 0 ;;
  *) echo 'Usage: bash bin/install [--tools]' >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  echo 'Usage: bash bin/install [--tools]' >&2
  exit 2
fi
command -v conda >/dev/null || { echo 'Install Conda first, then rerun bash bin/install.'; exit 1; }
if conda env list --json | python -c 'import json,sys; from pathlib import Path; sys.exit(not any(Path(p).name == sys.argv[1] for p in json.load(sys.stdin)["envs"]))' "$target_env"; then
  echo "$target_env already exists; leaving it unchanged."
elif [ "$target_env" = table-dtr ]; then
  conda env create -f environment.yml
else
  conda create -y -n scidiscovery --override-channels -c conda-forge python=3.11 pip
  conda run -n scidiscovery python -m pip install -r requirements.txt
fi
echo "Activate it with: conda activate $target_env"
