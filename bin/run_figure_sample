#!/bin/bash
################################################################
# run_figure_sample     - Bash script
# Scientific Discovery
#
# Author: Adah Holt (AI-IR Lab, University of Southern Maine, 2026)
################################################################

usage() {
    echo "Samples 200 figures across arXiv categories for a given month."
    echo ""
    echo "usage: $0 <year> <month> [--data_dir DIR] [--output_tsv FILE]"
    echo ""
    echo "  year          Two-digit year (e.g. 24 for 2024)"
    echo "  month         Two-digit month (e.g. 10 for October)"
    echo "  --data_dir    Root directory of scraper output (default: arxiv_data)"
    echo "  --output_tsv  Output file path (default: sampled_figures.tsv)"
    echo ""
    echo "Examples:"
    echo "  $0 24 10"
    echo "  $0 24 10 --output_tsv results/sampled_24_10.tsv"
}

if [[ $1 == "--help" || $1 == "-h" ]]; then
    usage
    exit 0
fi

if [ $# -lt 2 ]; then
    usage
    exit 1
fi

YEAR=$1
MONTH=$2
shift 2

if command -v conda &> /dev/null; then
    CONDA_CMD="conda"
elif [ -f "$HOME/miniconda3/bin/conda" ]; then
    CONDA_CMD="$HOME/miniconda3/bin/conda"
else
    echo "Error: conda not found. Run 'bash bin/install' first."
    exit 1
fi

if ! "$CONDA_CMD" env list | grep -qw "scidiscovery"; then
    echo "Error: scidiscovery environment not found. Run 'bash bin/install' first."
    exit 1
fi

echo "[ Running figure sampler for $YEAR/$MONTH ]"
"$CONDA_CMD" run --no-capture-output -n scidiscovery python3 query_generator/sample_figures.py "$YEAR" "$MONTH" "$@"
echo "Figure sampling complete."