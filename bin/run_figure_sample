#!/bin/bash

################################################################
# run_figure_sample     - Bash script
# Scientific Discovery
#
# Author: Adah Holt (AI-IR Lab, University of Southern Maine, 2026)
################################################################

usage() {
    echo "Samples 200 figures across arXiv categories for a given month."
    echo "usage: $0 [-year] [-month] [--data_dir] [--output_tsv]"
    echo "  -year       Two-digit year (e.g. 24 for 2024)"
    echo "  -month      Two-digit month (e.g. 10 for October)"
    echo "  --data_dir  Root directory of scraper output (default: arxiv_data)"
    echo "  --output_tsv  Output file path (default: 200_sampled_figures.tsv)"
}

if [[ $# == "--help" || $# == "-h" ]];
then
    usage
    exit 1
fi

if [ $# -le 1 ]
then
    usage
    exit 1
fi

CONDSH=`conda info | grep 'base environment' | awk '{print $4}'`/etc/profile.d/conda.sh
source $CONDSH
echo "[ Running figure sampler for $1/$2 ]"
CENV=`conda info --envs`
if grep -w "scientific-discovery" <<< "$CENV"
then
    source $CONDSH
    conda activate scientific-discovery
    python3 query_generator/figure_dictionary.py "$1" "$2" "${@:3}"
    echo "Figure sampling complete."
else
    echo "Conda environment not found -- run bin/install first."
fi
