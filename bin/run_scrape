#!/bin/bash

################################################################
# run_scrape     - Bash script
# Scientific Discovery
#
# Author: Adah Holt (AI-IR Lab, University of Southern Maine, 2026)
################################################################

usage() {
    echo "This script scrapes arXiv HTML pages for a given year and month,"
    echo "extracting paper metadata, figures, captions, and in-text references."
    echo "usage: $0 [-year] [-month]"
    echo "  -year   Two-digit year (e.g. 24 for 2024)"
    echo "  -month  Two-digit month (e.g. 10 for October)"
}

# Check whether user supplied -h or --help
if [[ $1 == "--help" || $1 == "-h" ]];
then
    usage
    exit 1
fi

# If less than two arguments supplied, display usage
if [ $# -le 1 ]
then
    usage
    exit 1
fi

# Initialize conda if installed via Miniconda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# Initialize conda if installed via Miniconda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

CONDSH=`conda info | grep 'base environment' | awk '{print $4}'`/etc/profile.d/conda.sh
source $CONDSH
echo "[ Running arXiv scraper for $1/$2 ]"
CENV=`conda info --envs`
if grep -w "scidiscovery" <<< "$CENV"
then
    # Initialize conda if installed via Miniconda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# Initialize conda if installed via Miniconda
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

CONDSH=`conda info | grep 'base environment' | awk '{print $4}'`/etc/profile.d/conda.sh
    source $CONDSH
    conda run -n scidiscovery python3 ar5ive_scraper/full_ar5ive_scraper.py "$1" "$2"
    echo "Scrape complete."
else
    echo "Conda environment not found -- run bin/install first."
fi
