#!/bin/bash
################################################################
# run_table_scrape     - Bash script
# Scientific Discovery
#
# Author: Adah Holt (AI-IR Lab, University of Southern Maine, 2026)
################################################################

usage() {
    echo "Scrapes arXiv HTML pages for a given year and month,"
    echo "extracting tables, captions, cell grids, footnotes, and in-text references."
    echo ""
    echo "usage: $0 <year> <month> [--max-papers N] [--start-id N]"
    echo ""
    echo "  year          Two-digit year (e.g. 24 for 2024)"
    echo "  month         Two-digit month (e.g. 10 for October)"
    echo "  --max-papers  Stop after N papers (useful for testing)"
    echo "  --start-id    Resume from this paper sequence number (default 1)"
    echo ""
    echo "Examples:"
    echo "  $0 24 10                        # scrape all of October 2024"
    echo "  $0 24 10 --max-papers 5         # scrape first 5 papers only"
    echo "  $0 24 10 --start-id 200         # resume from paper 00200"
}

if [[ $1 == "--help" || $1 == "-h" ]]; then
    usage
    exit 0
fi

if [ $# -lt 2 ]; then
    usage
    exit 1
fi

YEAR=$1
MONTH=$2
shift 2

EXTRA_ARGS="$@"

# Initialize conda (works whether or not conda is already on PATH)
if ! command -v conda &> /dev/null; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

echo "[ Running arXiv table scraper for $YEAR/$MONTH ]"
conda run -n scidiscovery python3 scrapers/table_scraper.py "$YEAR" "$MONTH" $EXTRA_ARGS
echo "Table scrape complete."
