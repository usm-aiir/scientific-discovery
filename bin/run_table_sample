#!/bin/bash
################################################################
# run_table_sample     - Bash script
# Scientific Discovery
#
# Author: Adah Holt (AI-IR Lab, University of Southern Maine, 2026)
################################################################

usage() {
    echo "Builds a stratified random sample of 200 tables from scraper output."
    echo ""
    echo "usage: $0 [output_dir] [output_tsv]"
    echo ""
    echo "  output_dir   Root directory of scraper output (default: arxiv_data)"
    echo "  output_tsv   Path for output file (default: sampled_tables.tsv)"
    echo ""
    echo "Examples:"
    echo "  $0"
    echo "  $0 arxiv_data sampled_tables.tsv"
}

if [[ $1 == "--help" || $1 == "-h" ]]; then
    usage
    exit 0
fi

# Initialize conda (works whether or not conda is already on PATH)
if ! command -v conda &> /dev/null; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

echo "[ Running table sampler ]"
conda run -n scidiscovery python3 query_generator/table_sampler.py \
    "${1:-arxiv_data}" \
    "${2:-sampled_tables.tsv}"
echo "Sampling complete."
